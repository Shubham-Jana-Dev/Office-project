# ============================================================
# Backend Environment Variables — TEMPLATE (safe to commit)
# Copy this file to .env and fill in your actual values.
# ============================================================

# --- Database (Aiven MySQL / any MySQL) ---
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=28072
DB_USER=avnadmin
DB_PASSWORD=your-database-password-here
DB_NAME=defaultdb

# Composed connection string (used by SQLAlchemy)
# Constructed automatically from the above vars in config.py,
# but you can also override it directly here.
DATABASE_URL=mysql+pymysql://avnadmin:your-database-password-here@your-mysql-host.aivencloud.com:28072/defaultdb

# --- Flask Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-flask-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# --- Flask Runtime ---
FLASK_ENV=production
PORT=5001
